# ==============================================================================
# SCAR E-COMMERCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the application.
# Sensitive values must NEVER be committed to version control.
# In local demo mode, all external integrations gracefully fallback to offline/simulated handlers.

# --- SERVER CONFIGURATION ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api/v1
LOG_LEVEL=info

# --- DATABASE & PERSISTENCE ---
# Standard MongoDB connection string.
# If omitted or unavailable, SCAR automatically activates the bundled Demo Catalog provider.
MONGODB_URI=mongodb://localhost:27017/scar_ecommerce

# --- CACHE & DISTRIBUTED LOCKS ---
# Redis URI for session storage, distributed rate limiting, and cache layer.
# If omitted, memory fallback is used with appropriate warnings.
REDIS_URL=redis://localhost:6379

# --- SECURITY & AUTHENTICATION ---
# Generate high-entropy strings using `openssl rand -hex 32`
JWT_ACCESS_SECRET=scar_jwt_access_secret_super_secure_random_hex_key_32_chars_min
JWT_REFRESH_SECRET=scar_jwt_refresh_secret_super_secure_random_hex_key_32_chars_min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- ADMIN BOOTSTRAP CREDENTIALS ---
# Automatically seeded on startup if no admin account exists
ADMIN_EMAIL=admin@scar.local
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME=System Administrator

# --- PAYMENT INTEGRATION ---
# Options: simulated | razorpay | stripe
PAYMENT_GATEWAY_PROVIDER=simulated
PAYMENT_CURRENCY=INR

# Razorpay Sandbox Credentials (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe Sandbox Credentials (Optional)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CLOUDINARY MEDIA ASSETS ---
# If credentials are not provided, SCAR seamlessly serves local high-res curated assets from the local catalog manifest.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI RECOMMENDATIONS ---
# Options: deterministic | openai | gemini
AI_RECOMMENDATION_PROVIDER=deterministic
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- EMAIL SERVICE (OPTIONAL) ---
# For order receipts and password resets in staging/production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@scar.local
